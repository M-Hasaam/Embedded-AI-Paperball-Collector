*.pt
# ...except the pretrained base weights the trainers start from (5.6 MB, Ultralytics AGPL-3.0)
!Training/yolo11n.pt
# ...and the current trained paper-ball model (replaced by each new version)
!Training/paper_ball_detector/roboflow-paperball.pt
!Training/paper_ball_detector/roboflow-paperball.onnx
# Real dataset configs (copy of dataset.yaml.example); the .example file stays tracked
Training/litter_detector/dataset.yaml
Training/litter_detector/my_dataset.yaml
# Export staging/backups. The app's litter_detector.tflite and labels.txt are NOT ignored.

# Arduino/ESP32 build output
Embedded/**/build/
Embedded/esp32-cam/captures/
Embedded/captures/
# everything the dashboard writes (the car's address, the servo memory, the runner log, the calibration, the grab spot)
Dashboard/data/
Simulation/data/

# The datasets (Training/*/dataset) are tracked. Only the derived zip is ignored.
Training/*/dataset.zip
